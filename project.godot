; Engine configuration file.

config_version=5

[application]

config/name="LAUNCH"
config/description="100-night narrative incremental about building a fireworks career. Stage 2: text-only loop validation."
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

BalanceConfig="*res://scripts/autoload/BalanceConfig.gd"
